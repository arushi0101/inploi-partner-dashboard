{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.hubspot.com https://*.hubspotpreview.com" }
      ]
    }
  ]
}
